                    "rawSql": "SELECT \n  stand,\n  tenant_code as airport,\n  COUNT(*) as event_count,\n  MAX(event_time_stamp) as last_event\nFROM turnaround_events\nWHERE event_time_stamp >= NOW() - INTERVAL '24 hours'\n  AND (${icao:sqlstring} = '.*' OR tenant_code = ${icao:sqlstring})\nGROUP BY stand, tenant_code\nORDER BY event_count DESC\nLIMIT 20;",
