                    "rawSql": "SELECT\n  time_bucket('5 minutes', event_time_stamp) AS time,\n  stand,\n  COUNT(*) as events\nFROM turnaround_events\nWHERE event_time_stamp >= NOW() - INTERVAL '6 hours'\n  AND (${icao:sqlstring} = '.*' OR tenant_code = ${icao:sqlstring})\nGROUP BY time, stand\nORDER BY time;",
